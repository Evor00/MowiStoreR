# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL (Docker development default)
DATABASE_URL=postgresql://mowi:mowi@db:5432/mowistore
DATABASE_SSL_REQUIRE=False
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-token

# Spring Boot service (Stripe + Gemini)
CORE_API_URL=http://localhost:8000
CORE_SERVICE_TOKEN=replace-with-the-same-long-random-service-token
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
PAYMENT_CURRENCY=pen

# Docker Compose only
POSTGRES_DB=mowistore
POSTGRES_USER=mowi
POSTGRES_PASSWORD=mowi
